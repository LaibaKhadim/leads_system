NEXTAUTH_SECRET=change-this-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Turso (hosted libSQL) — required in production (e.g. Netlify), since
# there's no persistent filesystem for a local leads.db file there.
# Leave both blank for local dev: the app falls back to a local
# file:leads.db automatically (same as before).
#   1. npm install -g turso-cli  (or see https://docs.turso.tech/cli/installation)
#   2. turso auth login
#   3. turso db create leads-system
#   4. turso db show leads-system --url          -> TURSO_DATABASE_URL
#   5. turso db tokens create leads-system        -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gmail SMTP for account verification emails.
# GMAIL_USER: the Gmail address emails will be sent from.
# GMAIL_APP_PASSWORD: NOT your normal Gmail password. Generate one at
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification
#   enabled on the Google account). It's a 16-character code — paste it with
#   no spaces.
# If left unset, signup still works but the verification link is only
# printed to the server console instead of emailed (useful for local dev).
GMAIL_USER=
GMAIL_APP_PASSWORD=
